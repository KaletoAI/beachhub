{
	auto_https disable_redirects
}

# Admin-UI – nur über WireGuard. Die Hallenschnittstelle ist hier bewusst nicht erreichbar.
https://10.8.0.1:8443 {
	tls internal
	respond /hall/* 404
	reverse_proxy 127.0.0.1:8000
}

# Hallendienst – nur über WireGuard und nur mit Client-Zertifikat der internen CA
# (erzeugt mit `beachhub-core zertifikate`, siehe docs/betrieb/portal.md).
https://10.8.0.1:8444 {
	tls internal {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/beachhub-ca.crt
		}
	}
	# Planabruf (GET, kein Body) sowie Ereignis-/Statuslieferungen (POST, kleines JSON, bis zu
	# 500 Ereignisse je Lieferung) – 256 KB ist reichlich Puffer und begrenzt beliebig große
	# Anfragen von einem kompromittierten oder fehlerhaften Client.
	request_body {
		max_size 256KB
	}
	handle /hall/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		respond 404
	}
}

# Hauptsystem über WireGuard (Caddy mit mTLS, Port 8444 nur für /hall/*). Hostname statt IP: für
# eine IP-Adresse schicken TLS-Clients kein SNI, ohne SNI griffe client_auth bei Caddy nie
# (docs/betrieb/hauptsystem.md, Abschnitt „5b. Hallendienst anbinden“). docker-compose.yml löst
# den Namen per extra_hosts auf die WireGuard-Adresse des Hauptsystems auf.
CORE_URL=https://kern.beachhub.wg:8444
HALL_TOKEN=change-me
CORE_CLIENT_CERT=/zertifikate/halle.crt
CORE_CLIENT_KEY=/zertifikate/halle.key
CORE_CA=/zertifikate/caddy-root.crt
# Öffentlicher Signaturschlüssel von der System-Seite im Admin-UI
CORE_PUBLIC_KEY=
# Home Assistant
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
# Ablage
DATA_DIR=/data
HALL_TOML=/config/hall.toml
# Health-Endpunkt (Docker HEALTHCHECK, Monitoring). Nur bei Bedarf auf 0.0.0.0 setzen, siehe
# docs/betrieb/hallendienst.md.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8099
